cascade_controller_v1:
  ros__parameters:
    control_error_topic: "/avs/control_error"
    lane_state_topic: "/avs/lane_state"
    odom_topic: "/odom_raw"
    scan_topic: "/scan"
    cmd_vel_topic: "/cmd_vel"

    ref_topic: "/avs/cascade_controller_v1_ref"
    state_topic: "/avs/cascade_controller_v1_state"

    runtime_enable_topic: "/avs/cascade_enable_cmd"
    emergency_stop_topic: "/avs/cascade_emergency_stop"

    enable_cmd: false
    control_hz: 50.0
    error_timeout_s: 1.2
    blind_hold_s: 1.0

    startup_straight_s: 0.50
    startup_v: 0.040

    fps_init: 3.0
    fps_min: 0.8
    fps_max: 25.0
    fps_tau_s: 1.0
    target_distance_per_frame_m: 0.030

    v_max: 0.105
    v_center: 0.090
    v_min: 0.035
    v_curve_max: 0.055
    v_lane_change_max: 0.050
    v_recover_max: 0.060
    v_large_error: 0.040
    v_blind: 0.035
    v_jump_hold: 0.040

    track_width_m: 0.135
    wheel_radius_m: 0.0225

    epsilon_sign: 1.0
    theta_sign: 1.0
    theta_control_sign: -1.0
    invert_angular: false
    x_bias_m: 0.0

    median_window: 5
    error_filter_tau_s: 0.46
    derivative_filter_tau_s: 0.85

    x_deadband_m: 0.014
    theta_deadband_rad: 0.024

    center_x_m: 0.032
    center_theta_rad: 0.065

    near_x_m: 0.070
    near_theta_rad: 0.150

    large_error_x_m: 0.155
    large_error_theta_rad: 0.420

    curve_enter_x_m: 0.085
    curve_enter_theta_rad: 0.180
    curve_enter_kappa: 0.75
    curve_confirm_frames: 2
    curve_release_frames: 4

    max_abs_x_m: 0.42
    max_abs_theta_rad: 1.20
    min_valid_lookahead_m: 0.16

    jump_guard_enable: true
    jump_x_m: 0.160
    jump_theta_rad: 0.420
    jump_hold_s: 0.60

    k_pp_near: 0.15
    k_lat_near: 0.24
    k_theta_near: 0.12

    k_pp_mid: 0.45
    k_lat_mid: 0.56
    k_theta_mid: 0.22

    k_pp_curve: 0.78
    k_lat_curve: 0.78
    k_theta_curve: 0.30

    k_pp_large: 0.28
    k_lat_large: 0.40
    k_theta_large: 0.18

    kd_lat: 0.010
    kd_theta: 0.014

    k_slow_x: 1.90
    k_slow_theta: 1.10
    k_slow_kappa: 0.16

    omega_center_max: 0.000
    omega_near_max: 0.032
    omega_mid_max: 0.190
    omega_curve_max: 0.440
    omega_lane_change_max: 0.300
    omega_large_error_max: 0.240
    omega_abs_max: 0.500
    omega_deadband: 0.006

    v_rate_up: 0.14
    v_rate_down: 0.36
    omega_rate_center: 0.22
    omega_rate_mid: 0.58
    omega_rate_curve: 0.95

    ld_min_m: 0.18
    ld_max_m: 0.85
    default_lookahead_m: 0.42
    max_abs_kappa: 3.0

    v_max_cmd: 0.12
    omega_max_cmd: 0.70

    wheel_speed_rate: 0.18
    wheel_speed_decel_rate: 0.35

    same_direction_inner_fraction: 0.44
    same_direction_min_inner_mps: 0.020

    enable_soft_counter_turn: false
    counter_start_omega: 0.38
    counter_full_omega: 0.72
    counter_outer_min_mps: 0.040
    counter_outer_max_mps: 0.060
    counter_reverse_max_mps: 0.010

    inner_omega_deadband: 0.014

    enable_calibration: true
    linear_cmd_scale: 1.245
    angular_cmd_scale: 0.85

    enable_lidar_safety: true
    emergency_distance: 0.12
    stop_distance: 0.18
    slow_distance: 0.38
    front_angle_deg: 16.0

    check_cmd_vel_conflict: true
    allow_cmd_vel_conflict: false
    publish_zero_on_conflict: true

    stop_burst_count: 45
    stop_burst_dt: 0.025
    always_publish_stop_on_exit: true
