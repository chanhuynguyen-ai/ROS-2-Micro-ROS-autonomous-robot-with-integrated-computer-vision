        # Outer controller gains
        self.declare_parameter("k_pp_near", 0.15)
        self.declare_parameter("k_lat_near", 0.24)
        self.declare_parameter("k_theta_near", 0.12)

        self.declare_parameter("k_pp_mid", 0.45)
        self.declare_parameter("k_lat_mid", 0.56)
        self.declare_parameter("k_theta_mid", 0.22)

        self.declare_parameter("k_pp_curve", 0.78)
        self.declare_parameter("k_lat_curve", 0.78)
