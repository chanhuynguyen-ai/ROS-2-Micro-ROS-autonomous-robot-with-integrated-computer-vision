def clamp(value, low, high):
    return max(low, min(high, value))


def approach(current, target, max_delta):
    if target > current + max_delta:
        return current + max_delta
    if target < current - max_delta:
        return current - max_delta
    return target


def finite_float(value, default=None):
    try:
        v = float(value)
        if math.isfinite(v):
            return v
    except Exception:
        pass
    return default


def parse_bool(value, default=True):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() not in ["false", "0", "no", "none", "invalid", ""]
    if value is None:
        return default
    try:
        return bool(value)
    except Exception:
        return default


def yaw_from_quat(q):
    x = q.x
    y = q.y
    z = q.z
    w = q.w
    siny_cosp = 2.0 * (w * z + x * y)
    cosy_cosp = 1.0 - 2.0 * (y * y + z * z)
    return math.atan2(siny_cosp, cosy_cosp)


class CascadeControllerV1(Node):
    """
    cascade_controller_v1

    Integrated cascade controller for the optimized AVS vision pipeline.

    Inputs:
      /avs/control_error
      /avs/lane_state
      /odom_raw
      /scan
      /avs/cascade_enable_cmd
      /avs/cascade_emergency_stop

    Outputs:
      /cmd_vel
      /avs/cascade_controller_v1_ref
      /avs/cascade_controller_v1_state

    Design:
      outer loop: lane error -> v_ref, omega_ref
      inner loop: v_ref, omega_ref -> soft differential cmd_vel
    """

    def __init__(self):
        super().__init__("cascade_controller_v1")

        # Topics
        self.declare_parameter("control_error_topic", "/avs/control_error")
        self.declare_parameter("lane_state_topic", "/avs/lane_state")
        self.declare_parameter("odom_topic", "/odom_raw")
        self.declare_parameter("scan_topic", "/scan")
        self.declare_parameter("cmd_vel_topic", "/cmd_vel")
        self.declare_parameter("ref_topic", "/avs/cascade_controller_v1_ref")
        self.declare_parameter("state_topic", "/avs/cascade_controller_v1_state")
        self.declare_parameter("runtime_enable_topic", "/avs/cascade_enable_cmd")
        self.declare_parameter("emergency_stop_topic", "/avs/cascade_emergency_stop")

        # Runtime
        self.declare_parameter("enable_cmd", False)
        self.declare_parameter("control_hz", 50.0)
        self.declare_parameter("error_timeout_s", 1.2)
        self.declare_parameter("blind_hold_s", 1.0)
        self.declare_parameter("startup_straight_s", 0.50)
        self.declare_parameter("startup_v", 0.040)

        # Vision/FPS adaptive speed
        self.declare_parameter("fps_init", 3.0)
        self.declare_parameter("fps_min", 0.8)
        self.declare_parameter("fps_max", 25.0)
        self.declare_parameter("fps_tau_s", 1.0)
        self.declare_parameter("target_distance_per_frame_m", 0.030)

        # Speed plan
        self.declare_parameter("v_max", 0.105)
        self.declare_parameter("v_center", 0.090)
        self.declare_parameter("v_min", 0.035)
        self.declare_parameter("v_curve_max", 0.055)
        self.declare_parameter("v_lane_change_max", 0.050)
        self.declare_parameter("v_recover_max", 0.060)
        self.declare_parameter("v_large_error", 0.040)
        self.declare_parameter("v_blind", 0.035)
        self.declare_parameter("v_jump_hold", 0.040)

        # Vehicle geometry
        self.declare_parameter("track_width_m", 0.135)
        self.declare_parameter("wheel_radius_m", 0.0225)

        # Input convention
        self.declare_parameter("epsilon_sign", 1.0)
        self.declare_parameter("theta_sign", 1.0)
        self.declare_parameter("theta_control_sign", -1.0)
        self.declare_parameter("invert_angular", False)
        self.declare_parameter("x_bias_m", 0.0)

        # Filtering
        self.declare_parameter("median_window", 5)
        self.declare_parameter("error_filter_tau_s", 0.46)
        self.declare_parameter("derivative_filter_tau_s", 0.85)

        # Deadband/zones
        self.declare_parameter("x_deadband_m", 0.014)
        self.declare_parameter("theta_deadband_rad", 0.024)

        self.declare_parameter("center_x_m", 0.032)
        self.declare_parameter("center_theta_rad", 0.065)

        self.declare_parameter("near_x_m", 0.070)
        self.declare_parameter("near_theta_rad", 0.150)

        self.declare_parameter("large_error_x_m", 0.155)
        self.declare_parameter("large_error_theta_rad", 0.420)

        # Curve/intent detection
        self.declare_parameter("curve_enter_x_m", 0.085)
        self.declare_parameter("curve_enter_theta_rad", 0.180)
        self.declare_parameter("curve_enter_kappa", 0.75)
        self.declare_parameter("curve_confirm_frames", 2)
        self.declare_parameter("curve_release_frames", 4)

        # Outlier/dropout/jump guard
        self.declare_parameter("max_abs_x_m", 0.42)
